# Same-origin deployment and Vite development use a relative API URL.
VITE_API_BASE_URL=
# Configure the API origin at build time when hosting the frontend separately.
# VITE_API_BASE_URL=https://your-api.example
# Point the Vite development proxy at a different local API if needed.
# API_PROXY_TARGET=http://127.0.0.1:5000
