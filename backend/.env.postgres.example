# PostgreSQL + Vercel backend environment template. Do not commit actual values.
# This template does not activate the PostgreSQL migration in production on its own.
NODE_ENV=production
DB_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
CORS_ORIGIN=https://YOUR-FRONTEND.vercel.app
PG_POOL_MAX=3
TRUST_PROXY_HOPS=1

# Only for a deliberate one-time CLI schema initialization, NOT a permanent
# Vercel runtime environment variable. Run migrations from a trusted terminal.
# PG_ALLOW_SCHEMA_MIGRATION=YES
# ADMIN_PASSWORD=use-a-unique-strong-secret-only-for-admin-provisioning
