NODE_ENV=development
HOST=127.0.0.1
PORT=5000

DB_AUTH=sql
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=CollegeTimetableDB
DB_USER=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=false

# For Windows integrated authentication, set DB_AUTH=windows.
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Required for separate frontend hosting. Use a comma-separated origin allowlist.
CORS_ORIGIN=
# Set only when the exact number of trusted proxy hops is known.
TRUST_PROXY_HOPS=0
